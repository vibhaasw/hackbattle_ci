# GitHub
GITHUB_WEBHOOK_PORT=9001
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_TOKEN=replace-me

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=neural-chat:latest

# Queue / persistence
QUEUE_FILE_PATH=queue.json
STATS_FILE_PATH=stats.json

# Release logic
CHECK_INTERVAL_SECONDS=3600
GIT_COMMIT_TRIGGER=true
BUILD_SUCCESS_TRIGGER=true
MANUAL_TRIGGER_ENABLED=true
FOCUS_MODE=false

# Calendar (optional — Google Calendar free/busy)
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=token.json
CALENDAR_GATE_ENABLED=true

# Focus analytics
AVG_CONTEXT_SWITCH_COST_MINUTES=17.5
